{
  "name": "dsh-cognitive-kernel",
  "description": "Verification, memory, and reflection for DSH: the harness checks what the model claims",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "model"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-typert-protocol"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsdown && node scripts/check-client-bundle.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "vitest": "^4.1.8"
  },
  "_comment_react": "react is a required peer, never a dependency: the shell provides the single React instance, and a private copy makes every hook call fail across the boundary.",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.6-alpha.1",
    "@deepseek-ai/schemastery": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.6-alpha.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    }
  }
}
